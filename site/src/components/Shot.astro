---
// A screenshot in the browser-chrome frame, swapping light and dark sources
// on prefers-color-scheme. Only the matching source downloads.
//
// width and height are the intrinsic ratio the browser reserves space with,
// not a layout size -- the CSS is width: 100%, height: auto. They must match
// the file, and the files are no longer all one shape: the hero is a 16:9
// full-app capture and the rest are crops crediting whatever the row is about.
// Passing a stale 16:9 for a crop does not distort anything, because height is
// auto, but it reserves the wrong box and the page jumps when the shot loads.
// Both source files in a pair must share the ratio, which is why each is
// captured from one clip in both themes rather than framed twice.
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
  width?: number;
  height?: number;
}

const { name, alt, eager = false, width = 1920, height = 1080 } = Astro.props;
---

<div class="frame">
  <div class="frame-bar" aria-hidden="true">
    <i></i><i></i><i></i>
    <span class="frame-url">nojoin.your-server.net</span>
  </div>
  <picture>
    {/* Art direction on the system preference by default. When a visitor has
        chosen a theme, the script in Base.astro forces this source's media on
        or off; the picture element re-evaluates and still fetches one file. */}
    <source
      data-theme-source
      media="(prefers-color-scheme: dark)"
      srcset={`/images/${name}-dark.webp`}
    />
    <img
      src={`/images/${name}-light.webp`}
      alt={alt}
      width={width}
      height={height}
      loading={eager ? "eager" : "lazy"}
    />
  </picture>
</div>
