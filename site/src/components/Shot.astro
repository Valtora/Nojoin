---
// A screenshot in the browser-chrome frame, swapping light and dark sources
// on prefers-color-scheme. Only the matching source downloads. The shots are
// taken on a 1920x1080 desktop with the app's navigation collapsed, and ship
// as 2560x1440 WebP. The width and height below are the layout size and the
// aspect ratio the browser reserves, not the file's pixel size.
interface Props {
  name: string;
  alt: string;
  eager?: boolean;
}

const { name, alt, eager = false } = Astro.props;
---

<div class="frame">
  <div class="frame-bar" aria-hidden="true">
    <i></i><i></i><i></i>
    <span class="frame-url">nojoin.your-server.net</span>
  </div>
  <picture>
    {/* Art direction on the system preference by default. When a visitor has
        chosen a theme, the script in Base.astro forces this source's media on
        or off; the picture element re-evaluates and still fetches one file. */}
    <source
      data-theme-source
      media="(prefers-color-scheme: dark)"
      srcset={`/images/${name}-dark.webp`}
    />
    <img
      src={`/images/${name}-light.webp`}
      alt={alt}
      width="1920"
      height="1080"
      loading={eager ? "eager" : "lazy"}
    />
  </picture>
</div>
