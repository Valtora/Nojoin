---
import Mark from "./Mark.astro";
import { getStarCount, formatStarCount } from "../data/github";

const stars = await getStarCount();
---

<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/">
      <Mark />
      Nojoin
    </a>
    <nav class="site-nav" aria-label="Site">
      <a href="/compare/">Compare</a>
      <a href="https://github.com/Valtora/Nojoin/blob/main/docs/README.md">Docs</a>
      <a class="star-badge" href="https://github.com/Valtora/Nojoin">
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--action-text)">
          <path
            d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z">
          </path>
        </svg>
        Star on GitHub
        {stars !== null && <span class="count">{formatStarCount(stars)}</span>}
      </a>
    </nav>
  </div>
</header>
