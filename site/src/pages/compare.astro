---
// The comparison page. Claims are still checked against each vendor's own
// documentation before they go up -- that has not changed -- but the page no
// longer shows the URL and date behind each cell. Nobody else in this market
// footnotes a comparison, and a reader who wants to verify a row can. No
// pricing anywhere: prices change without notice, and a stale price is the
// error people screenshot.
import Base from "../layouts/Base.astro";
import { rows, summaryRows, products, type Verdict } from "../data/comparison";

const MARK: Record<Verdict, string> = { yes: "✓", partial: "~", no: "✗" };
const READS: Record<Verdict, string> = { yes: "Yes", partial: "Partly", no: "No" };

---

<Base
  title="Compare — Nojoin"
  description="How Nojoin compares to Jamie, Otter and Granola on capture, storage, self-hosting, licences and model choice."
>
  <main class="section">
    <div class="wrap">
      <div class="centered">
        <p class="eyebrow">Comparison</p>
        <h1 class="heading-2">Nojoin Next to Jamie, Otter and Granola</h1>
        <p class="lead" style="max-width: 62ch; margin-inline: auto;">
          Nojoin has taken no funding, employs nobody, and sells nothing you can't
          download. Here it is next to three products that raised money to build the same
          thing.
        </p>
        <p class="lead" style="max-width: 62ch; margin-inline: auto; font-size: 1rem;">
          Every claim below comes from that vendor's own current documentation. Where
          they're better, the table says so — which is the part most comparison pages
          leave out.
        </p>
      </div>

    </div>

    <div class="wrap-wide">
      <h2 class="heading-3 glance-heading">At a glance</h2>
      <div class="table-wrap">
        {/* aria-label rather than a visible <caption>: the table still needs an
            accessible name, but the sentence explaining it duplicated the heading
            above it. */}
        <table class="compare-table glance-table" aria-label="At a glance comparison">
          <thead>
            <tr>
              <th scope="col"></th>
              {products.map((p) => <th scope="col">{p.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              summaryRows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {products.map((p) => {
                    const cell = row.cells[p.key];
                    return (
                      <td class="glance-cell" data-verdict={cell.verdict}>
                        <span class="glance-mark" aria-hidden="true">{MARK[cell.verdict]}</span>
                        <span class="visually-hidden">{READS[cell.verdict]}. </span>
                        <span class="glance-note">{cell.note}</span>
                      </td>
                    );
                  })}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="heading-3 glance-heading">Detailed comparison</h2>
      <div class="table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th scope="col"></th>
              {products.map((p) => <th scope="col">{p.name}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {products.map((p) => (
                    <td>{row.cells[p.key].text}</td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

    </div>
  </main>
</Base>
