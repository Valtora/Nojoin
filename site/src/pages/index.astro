---
// The landing page. Every claim here is traceable to README.md or docs/*;
// nothing is invented for marketing effect. Every Shot is a real capture from
// a seeded demonstration instance, cropped to the thing its row is about, and
// carries the true pixel dimensions of its file so the browser reserves the
// right box before the image loads.
import Base from "../layouts/Base.astro";
import Shot from "../components/Shot.astro";

const docs = "https://github.com/Valtora/Nojoin/blob/main/docs";
---

<Base
  title="Nojoin"
  ogTitle="Nojoin — agentic meeting intelligence on your own server"
  description="Meeting intelligence on hardware you own, with no bot in the call. Nojoin hands your whole meeting library to Claude or ChatGPT through thirty tools that change the record rather than just read it. Nothing is capped."
>
  <main>
    <section class="hero">
      <div class="wrap">
        <h1 class="display">
          {/* The space is explicit because Astro's HTML compression strips the
              whitespace between these two elements. Above 48rem they are
              display:block and it makes no difference; below it they are inline
              and the headline ran together as "easy.Agentic". */}
          <span>Transcription is easy.</span>{" "}
          <span>Agentic meeting intelligence isn't.</span>
        </h1>
        <p class="lead">
          No bot joins the call — Meet, Teams or Zoom, with nothing to install — and nothing
          leaves your server. Then Nojoin hands the whole library to the assistant you already use.
          <mark class="hl">It was built to be that bridge, and nothing about it is metered.</mark>
        </p>
        <div class="ctas">
          <a class="btn btn-primary" href="#quick-start">Get started</a>
          <a class="btn btn-secondary" href="https://github.com/Valtora/Nojoin">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="color: var(--action-text)">
              <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z"></path>
            </svg>
            Star on GitHub
          </a>
        </div>
      </div>
      <div class="wrap-shot hero-shot">
        <Shot name="dashboard" alt="The Nojoin dashboard: recordings, upcoming meetings and search" eager />
      </div>
    </section>

    {/* The agent band, directly under the hero: the MCP surface is the
        capability with no equivalent elsewhere, so the page argues it first and
        everything below is evidence for it. The three-up strip that used to sit
        between them is gone -- it restated two of the hero's own claims before
        the reader had scrolled past them. No screenshot, deliberately, and it
        has now been tried both ways: the work happens in Claude's or ChatGPT's window, and a
        capture of Nojoin's own transcript showing the AI-corrected labels
        turned out to say the same thing as the transcripts row two sections
        below. Three devices carry it instead, each with a claim no capture
        makes. See SITE.md, "Design direction". */}
    <section class="agent-band" aria-label="Agent access">
      <div class="wrap">
        <div class="agent-grid">
          <div class="agent-copy">
            <p class="eyebrow">Agents</p>
            <h2 class="heading-2">An Assistant That Changes the Record, Not Just Reads It</h2>
            <p>
              Connect Claude or ChatGPT to your own instance. Eighteen of the thirty tools
              write, authorised per user and on by default — no API key, nothing to paste.
              Every change is reversible, and the bin is the strongest delete it has.
            </p>
            <a class="text-link" href={`${docs}/MCP.md`}>
              The connector, tool by tool →
            </a>
          </div>

          <div class="flowcard">
            <p class="flowcard-label">After the Weekly Review</p>
            <ul class="flow-rows">
              <li><span class="pill pill-agent">Agent</span><span>Reads the transcript and the notes</span></li>
              <li><span class="pill pill-agent">Agent</span><span>Spots a name the diariser misheard</span></li>
              <li><span class="pill pill-nojoin">Nojoin</span><span>Corrects the utterance, and locks it against reprocessing</span></li>
              <li><span class="pill pill-nojoin">Nojoin</span><span>Files three tasks, each linked to the meeting</span></li>
              <li><span class="pill pill-agent">Agent</span><span>Reconciles the attendees with your CRM</span></li>
              <li><span class="pill pill-you">You</span><span>Check what it did</span></li>
            </ul>
          </div>
        </div>

        <ul class="toolrail">
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"></path>
              <path d="M19 10v2a7 7 0 0 1-14 0v-2"></path>
              <line x1="12" y1="19" x2="12" y2="22"></line>
            </svg>
            <h3>Recordings <span class="n">8</span></h3>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
              <path d="M14 2v5h5"></path>
              <path d="M8 13h8M8 17h5"></path>
            </svg>
            <h3>Transcript <span class="n">5</span></h3>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h6"></path>
              <path d="M14 2v5h5"></path>
              <path d="M18.4 13.6a2 2 0 0 1 2.8 2.8L17 20.6l-3 .7.7-3Z"></path>
            </svg>
            <h3>Notes and Documents <span class="n">5</span></h3>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <h3>People and Speakers <span class="n">5</span></h3>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect width="8" height="4" x="8" y="2" rx="1"></rect>
              <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
              <path d="m9 14 2 2 4-4"></path>
            </svg>
            <h3>Tasks <span class="n">3</span></h3>
          </li>
          <li>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7"></circle>
              <path d="m21 21-4.3-4.3"></path>
            </svg>
            <h3>Calendar, Search and Tags <span class="n">4</span></h3>
          </li>
        </ul>

        <div class="bridge">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 3 4 7l4 4"></path>
            <path d="M4 7h16"></path>
            <path d="m16 21 4-4-4-4"></path>
            <path d="M20 17H4"></path>
          </svg>
          <div>
            <h3>The Bridge Between Your Meetings and Any CRM</h3>
            <p>
              Nojoin ships no CRM integration and needs none. An assistant already connected
              to HubSpot or Airtable reconciles both sides itself, because Nojoin exposes plain
              primitives rather than a partner list. Nothing to wait for, nothing to be dropped
              from.
            </p>
            <div class="bridge-chips">
              <span>HubSpot</span><span>Airtable</span><span>Salesforce</span>
              <span>A spreadsheet</span><span>Whatever it can already reach</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="feature" data-shot="right">
          <div class="feature-copy">
            <p class="eyebrow">Meeting Edge</p>
            <h2 class="heading-2">Guidance While the Meeting Is Still Happening</h2>
            <p>
              Questions worth asking, points you've missed and concepts explained as they come
              up — grounded in what has actually been said so far.
            </p>
            <a class="text-link" href={`${docs}/USAGE.md`}>How it works in practice →</a>
          </div>
          <div class="feature-shot">
            <Shot
              name="edge"
              alt="The Meeting Edge panel during a live call: a running summary, questions worth asking, points to raise, and definitions for the terms being used"
              width={1260}
              height={1180}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="feature" data-shot="left">
          <div class="feature-copy">
            <p class="eyebrow">Transcripts</p>
            <h2 class="heading-2">Every Word, Attributed to the Right Person</h2>
            <p>
              Voiceprints, not name tags. Name someone once and they stay named across every
              future meeting. Corrections take one click.
            </p>
            <a class="text-link" href={`${docs}/USAGE.md`}>Speakers and voiceprints →</a>
          </div>
          <div class="feature-shot">
            <Shot
              name="transcript"
              alt="A diarised transcript moving between four named speakers, each utterance timestamped and colour-coded to the person who said it"
              width={1088}
              height={1040}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="wrap">
        <div class="feature" data-shot="right">
          <div class="feature-copy">
            <p class="eyebrow">Notes</p>
            <h2 class="heading-2">Notes Written From What Was Actually Said</h2>
            <p>
              A summary, the decisions and the actions, written from the transcript by a model
              you choose — your own API key, or Ollama on the same machine. One query searches
              the notes, the transcript and your documents together.
            </p>
            <a class="text-link" href={`${docs}/USAGE.md`}>Notes, search and Meeting Chat →</a>
          </div>
          <div class="feature-shot">
            <Shot
              name="notes"
              alt="Generated meeting notes: a summary paragraph, then a Key Decisions table listing each decision against its rationale"
              width={1132}
              height={858}
            />
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="quick-start">
      <div class="wrap">
        <div class="qs">
          <div>
            <p class="eyebrow">Quick Start</p>
            <h2 class="heading-2">Four Steps to Running</h2>
            <ol class="qs-steps">
              <li>Clone the repository.</li>
              <li>Create your deployment files from the tracked examples.</li>
              <li>Set <code>FIRST_RUN_PASSWORD</code> and <code>DATA_ENCRYPTION_KEY</code> in <code>.env</code>.</li>
              <li>Start it, then finish first-run setup at <code>/setup</code>.</li>
            </ol>
            <a class="text-link" href={`${docs}/GETTING_STARTED.md`} style="display: inline-flex; margin-top: 1.25rem;">
              The full path, step by step →
            </a>
          </div>
          <pre class="code-block"><code><span class="c-kw">git</span> clone <span class="c-str">https://github.com/Valtora/Nojoin</span>
<span class="c-kw">cd</span> Nojoin
<span class="c-kw">cp</span> docker-compose.example.yml docker-compose.yml
<span class="c-kw">cp</span> .env.example .env
<span class="c-com"># set FIRST_RUN_PASSWORD and DATA_ENCRYPTION_KEY</span>
<span class="c-kw">docker</span> <span class="c-name">compose</span> up <span class="c-p">-d</span></code></pre>
        </div>
      </div>
    </section>

    <section class="band centered" aria-label="Comparison">
      <div class="wrap">
        <h2 class="heading-2">How It Compares</h2>
        <p class="lead">
          Jamie, Otter and Granola, on the axes that decide who owns the meeting.
        </p>
        <div class="ctas">
          <a class="btn btn-secondary" href="/compare/">See the comparison</a>
        </div>
      </div>
    </section>

    {/* The managed teaser is the closer, and there is no separate repeat-CTA
        band after it. The old one asked for the same thing the hero already
        asks for, one screen further down a page that had grown too long. This
        keeps the page's one loud surface and ends on the only offer the hero
        does not make. */}
    <section class="closer" aria-label="Managed service">
      <div class="wrap">
        <h2 class="heading-2">Or Have Someone Else Run It</h2>
        <p style="font-size: 1rem; margin-top: 0.75rem;">
          Nojoin's developer will scope the hardware, set an instance up on a machine you own,
          and keep it patched, watched and backed up. £24.99 a person a month, from five people.
        </p>
        <div class="ctas">
          <a class="btn btn-inverse" href="/managed/">The managed service</a>
        </div>
      </div>
    </section>
  </main>
</Base>
