---
// P5 replaces this placeholder main with the landing sections. The chrome
// around it (Base, Header, Footer) is the real P2 foundation.
import Base from "../layouts/Base.astro";
---

<Base
  title="Nojoin"
  description="Self-hosted meeting transcription and notes. No bot joins the call; everything is processed on your own server."
>
  <main class="section">
    <div class="wrap" style="text-align: center;">
      <h1 class="display">Meeting notes, with no bot in the call</h1>
      <p class="lead" style="max-width: 52ch; margin: 1.375rem auto 0;">
        The landing page lands here in this pull request. This build proves the design
        foundation: shared tokens, both themes, and the site chrome.
      </p>
    </div>
  </main>
</Base>
