---
import "../styles/site.css";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Page not found</title>
  </head>
  <body class="grid min-h-screen place-items-center bg-[#161616] text-[#e5e7eb]">
    <main class="px-6 text-center">
      <h1 class="text-2xl font-semibold text-[#ededed]">Page not found</h1>
      <p class="mt-2 text-sm text-[#a1a1aa]">
        There is nothing at this address. <a href="/" class="text-[#fb923c] underline">Go to the front page.</a>
      </p>
    </main>
  </body>
</html>
