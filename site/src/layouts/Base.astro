---
// The one layout. Token order matters: the app's tokens.css first (the
// app-tokens-media plugin appends its dark block as a media query), then the
// site stylesheet, whose site-tokens.css supplies the site-only families.
import "../../../frontend/src/app/tokens.css";
import "../styles/site.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
}

// The tab title and the share-card title are deliberately allowed to differ.
// A browser tab wants the shortest thing that identifies the site; a Slack or
// LinkedIn card is read cold by someone who has never heard of it and wants
// the descriptive line. `ogTitle` defaults to `title`, so a page only sets it
// where the two genuinely want different words -- currently the landing page.
const { title, description, ogTitle = title } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

// Cloudflare Web Analytics. This is the beacon siteTag, not an API token: it
// grants nothing, has no scopes, and ships in the markup of every page that
// uses Web Analytics. Do not put a Cloudflare API token here.
//
// It comes from the environment rather than from source, and the reason is
// pollution rather than secrecy -- a build-time value is inlined into the HTML
// either way, so an env var hides nothing. What it does do is keep the beacon
// out of local builds. A source constant would fire real page views from every
// `npm run build` and every preview tunnel, tagged with a throwaway hostname,
// straight into the live figures.
//
// CI supplies it as a repository variable. Empty is a supported state and
// renders no beacon at all, which is what every local build gets.
const CF_BEACON_TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN ?? "";
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* One fixed card for every page. Open Graph images cannot follow
        prefers-color-scheme, so this commits to the dark treatment rather than
        pairing light and dark the way the screenshots do. Absolute URL because
        relative og:image is not resolved by every crawler.

        The card is generated by site/scripts/build-og-card.mjs and carries the
        hero headline. Both it and the alt text below must be regenerated when
        that headline changes -- the card was hand-made once and then advertised
        a superseded tagline through two rewrites. */}
    <meta property="og:image" content={new URL("/images/og-card.png", Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nojoin: transcription is easy, agentic meeting intelligence isn't" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Render-blocking on purpose: stamping the stored choice before the first
        paint is what stops a light flash on the way to a dark page. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("nojoin-theme");
          if (stored === "light" || stored === "dark") {
            document.documentElement.dataset.theme = stored;
          }
        } catch (error) {
          /* Private mode and blocked storage both land here. The system
             preference still applies, so there is nothing to recover from. */
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      (function () {
        var root = document.documentElement;

        function activeTheme() {
          if (root.dataset.theme) return root.dataset.theme;
          return window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        }

        // Screenshots are art-directed on prefers-color-scheme, which a chosen
        // theme has to override. Forcing each source's media is enough: the
        // picture element re-evaluates and still fetches only one file.
        function applyShots(theme) {
          document
            .querySelectorAll("picture > source[data-theme-source]")
            .forEach(function (source) {
              source.media = theme === "dark" ? "all" : "not all";
            });
        }

        if (root.dataset.theme) applyShots(root.dataset.theme);

        var toggle = document.querySelector("[data-theme-toggle]");
        if (!toggle) return;

        function label() {
          var next = activeTheme() === "dark" ? "light" : "dark";
          toggle.setAttribute("aria-label", "Switch to " + next + " theme");
        }
        label();

        toggle.addEventListener("click", function () {
          var next = activeTheme() === "dark" ? "light" : "dark";
          try {
            localStorage.setItem("nojoin-theme", next);
          } catch (error) {
            /* Nothing to persist to; reloading would drop the choice, so apply
               it in place instead and let it last the page view. */
            root.dataset.theme = next;
            applyShots(next);
            label();
            return;
          }
          window.location.reload();
        });
      })();
    </script>
    {CF_BEACON_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${CF_BEACON_TOKEN}"}`}
      />
    )}
  </body>
</html>
