# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Tool caches. pyproject.toml points pytest, ruff and mypy at /.cache/; the bare
# names are kept so a checkout that predates that (or a tool invoked with an
# explicit override) still ignores its cache.
/.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
backend/tests/__pycache__/
backend/tests/pipeline_fixtures/generated/

# Environment
/.venv
# User data directory when building from source or developing, also contains the config.json file which may have sensitive info
/data

# IDE and AI/Agent
*.mdc
/.vscode
.github/copilot-instructions.md
.agent/*
*.code-workspace
*.qwen/
*.antigravity-cli/

# Logs
*.log

# Dist and Output Folders and Files
/output/
/dist
telemetry/dist/
site/dist/
site/.astro/
site/.wrangler/

# Companion App (Rust)
companion/target/
companion/dist/
companion/src-tauri/target/
companion/src-tauri/gen/
companion/src-tauri/schemas/

# Environment Variables
.env
.env.*
!.env.example

# Node modules
node_modules/

# macOS
.DS_Store

# Security / Certificates
*.key
*.sig
*.pem
*.crt
*.pfx
*.p12
nginx/*.key
nginx/*.crt
nginx/*.pem

# Audio Files
*.wav
*.opus

# Docker Compose
docker-compose.yml
docker-compose.yaml
