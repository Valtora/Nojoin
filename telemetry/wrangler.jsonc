{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nojoin-telemetry",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-25",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // The ingest is reached only at this hostname. Keeping it on its own
  // subdomain means telemetry can be blocked at DNS by an operator who wants
  // belt and braces on top of the in-app opt-out, without touching the app.
  "routes": [
    {
      "pattern": "telemetry.nojoin.co.uk",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nojoin-telemetry",
      "database_id": "9ea9c413-8a9d-44d3-86ac-cbe9ba91d6db"
    }
  ],
  // Flood guard only. A legitimate install sends at most five requests per
  // day, one heartbeat and four diagnostics pings, plus a heartbeat retry an
  // hour after a failure, so this is orders of magnitude above real use and exists
  // to stop a script from burning the daily Workers quota and taking real
  // installs offline. The key is the connecting address, so it also has to
  // tolerate several installs sharing one NAT egress.
  "ratelimits": [
    {
      "name": "PING_LIMITER",
      "namespace_id": "1",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ],
  // No scheduled work. Rows are kept indefinitely, so the retention sweep that
  // used to run here is gone. The empty list is explicit rather than omitted,
  // so a deploy removes the old 03:00 trigger instead of leaving it pointing at
  // a handler that no longer exists.
  "triggers": {
    "crons": []
  }
}
