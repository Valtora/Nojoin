# --- Builder Stage ---
# CPU, CUDA/NVIDIA, and ROCm profiles supply a base image and backend explicitly.
# No vendor-specific accelerator backend is selected implicitly.
ARG TORCH_BASE_IMAGE
ARG WORKER_INFERENCE_BACKEND
FROM ${TORCH_BASE_IMAGE} AS builder
ARG WORKER_INFERENCE_BACKEND
ARG TORCH_VERSION
ARG TORCHAUDIO_VERSION

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

COPY requirements/ /app/requirements/
COPY docker/worker-backends/ /opt/nojoin-worker-backends/

# Keep the generated venv in this stage so ROCm's existing /opt/venv is reused
# directly by the final stage rather than copied on top of itself. The CPU base
# installs CPU-only PyTorch into the same venv; CUDA and ROCm reuse their base
# image's matched torch/torchaudio. Keep the CPU base interpreter installed at
# runtime because the venv links to it; remove only its build-time venv tooling.
ENV PATH="/opt/venv/bin:$PATH"
RUN . "/opt/nojoin-worker-backends/${WORKER_INFERENCE_BACKEND}.sh" && \
    apt-get update && apt-get install -y --no-install-recommends \
    git \
    libpq-dev \
    libssl-dev \
    libffi-dev \
    build-essential \
    python3-venv \
    && worker_install_builder_os_packages \
    && python3 -m venv --system-site-packages /opt/venv \
    && worker_install_torch \
    && python -c "import torch; print(f'torch=={torch.__version__}')" > constraints.txt \
    && python -c "import torchaudio; print(f'torchaudio=={torchaudio.__version__}')" >> constraints.txt \
    && pip install --no-cache-dir -r requirements/worker.txt -c constraints.txt \
    && pip install --no-cache-dir --no-deps pyannote.audio==4.0.5 -c constraints.txt \
    && worker_install_backend_packages \
    && apt-get purge --auto-remove -y \
         git libpq-dev libssl-dev libffi-dev build-essential python3-venv \
    && worker_cleanup_builder_os_packages \
    && /opt/venv/bin/python -c "import sys; print('Worker Python:', sys.version)" \
    && rm -f constraints.txt \
    && rm -rf /var/lib/apt/lists/*

# --- Runtime Stage ---
# Reuse the prepared builder filesystem instead of copying /opt/venv into a
# second copy of the base image. This is especially important for AMD's ROCm
# image, which already stores its ~20 GB PyTorch environment under /opt/venv.
FROM builder AS runtime
ARG WORKER_INFERENCE_BACKEND

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:$PATH"
ENV MALLOC_ARENA_MAX=2
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2

RUN . "/opt/nojoin-worker-backends/${WORKER_INFERENCE_BACKEND}.sh" && \
    apt-get update && \
    # Patch the base image's OpenSSL against CVE-2026-45447 (PKCS7_verify UAF);
    # the pinned PyTorch base predates the Ubuntu fix (3.0.13-0ubuntu3.11).
    apt-get install -y --no-install-recommends --only-upgrade openssl libssl3t64 && \
    apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libpq5 \
    libjemalloc2 \
    gosu \
    # Local OCR for document parsing: the middle tier between a vision model
    # and a format's own text layer, so a scanned page is readable with no AI
    # provider configured. The system binary rather than an ONNX OCR package on
    # purpose, avoiding another onnxruntime dependency alongside the selected
    # CUDA or CPU ONNX Runtime package.
    # -eng only; other language packs are ~4 MB each and unused.
    tesseract-ocr \
    tesseract-ocr-eng \
    && worker_install_runtime_os_packages \
    && \
    # The worker runs Celery and never invokes uv; remove the base image's uv
    # binaries so their bundled rustls-webpki (GHSA-82j2-j2ch-gfr8) is absent
    # from the published runtime image.
    rm -f /usr/local/bin/uv /usr/local/bin/uvx && \
    rm -rf /var/lib/apt/lists/*

# The PyTorch base ships a system Python with vulnerable pillow/urllib3 in
# /usr/local/lib/.../dist-packages. The venv (system-site-packages) shadows them
# at import time with the patched versions from requirements, but the old files
# remain on disk and are flagged by the image scan. Upgrade the system copies in
# place (as root, before the USER switch) to the same patched versions. Keep these
# pins in step with requirements/base.txt: pillow==12.3.0 closes the batch of
# HIGH pillow CVEs disclosed after v1.5.0 (CVE-2026-54058/54059/54060, 55379/55380,
# 59197/59199/59200/59204/59205); urllib3==2.7.0 closes CVE-2026-44431/44432.
RUN . "/opt/nojoin-worker-backends/${WORKER_INFERENCE_BACKEND}.sh" && \
    worker_patch_system_python

# Backend-specific runtime libraries are configured by the selected profile
# hook: CUDA discovers its nvidia-* wheel libraries, while ROCm uses the base.
RUN . "/opt/nojoin-worker-backends/${WORKER_INFERENCE_BACKEND}.sh" && \
    worker_configure_runtime_libraries && \
    rm -rf /opt/nojoin-worker-backends

# Exercise the final Python/runtime stack for every backend during image builds.
# Device discovery itself requires a supported host and is checked at runtime.
RUN /opt/venv/bin/python -c \
    "import celery, onnxruntime as ort, torch, torchaudio; \
     backend='${WORKER_INFERENCE_BACKEND}'; \
     assert backend != 'cuda' or torch.version.cuda; \
     assert backend != 'rocm' or torch.version.hip; \
     assert backend != 'cpu' or (torch.version.cuda is None and torch.version.hip is None); \
     print('Worker runtime:', backend, torch.__version__, torchaudio.__version__, ort.get_available_providers())"

WORKDIR /app

COPY . .

# Create the non-root appuser that the entrypoint drops to at runtime.
# The Ubuntu 24.04-based PyTorch image ships a default user at UID 1000; remove
# whatever occupies 1000 first so appuser keeps UID 1000 for mounted-volume
# ownership. Create directories for volumes to ensure they are owned by appuser.
RUN if getent passwd 1000 >/dev/null 2>&1; then \
        userdel -r "$(getent passwd 1000 | cut -d: -f1)" 2>/dev/null || true; \
    fi && \
    useradd -m -u 1000 appuser && \
    mkdir -p /home/appuser/.cache/huggingface && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app /home/appuser

RUN chmod +x backend/worker_entrypoint.sh

# The image intentionally does NOT `USER appuser`: the entrypoint enters as root
# only to repair ./data bind-mount ownership, then drops to appuser via gosu, so
# the worker process runs as uid 1000 (asserted at runtime by the release smoke).
ENTRYPOINT ["backend/worker_entrypoint.sh"]

# Default command: a single worker draining all resource lanes (inference, files, io)
# with embedded Celery Beat (-B), so a standalone `docker run` of this image
# still processes everything and fires periodic jobs (15-minute calendar sync,
# 24-hour temp cleanup, calendar push-channel renewal). The beat schedule DB
# lives on the persistent ./data volume so the cadence survives restarts.
#
# In the Compose deployment this CMD is overridden: work is split across the
# worker-inference / worker-files / worker-io services, and beat (-B) runs on the
# io worker ONLY, so periodic jobs cannot double-schedule.
CMD ["celery", "-A", "backend.celery_app.celery_app", "worker", "-B", "-s", "/app/data/celerybeat-schedule", "-Q", "inference,files,io", "--pool=solo", "--concurrency=1", "--loglevel=info"]
