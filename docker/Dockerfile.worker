# --- Builder Stage ---
# Pinned by digest for reproducible builds; Dependabot keeps the tag comment current.
FROM pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime@sha256:3c0b174a1339193a5bcc4b37d737c9f5ca3c4782a2293d3888e4271367eddf44 AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# Install build dependencies. python3-venv is required because the PyTorch
# base image ships a system Python without ensurepip (it dropped the bundled
# conda environment), so `python -m venv` below cannot bootstrap pip otherwise.
#
# Upgrade first, as the runtime stage does. This stage ships only /opt/venv, but
# the venv's pip is Ubuntu's build, which verifies PyPI against the OS trust
# store alone. The pinned base is not republished, so without the upgrade a CA
# that Ubuntu has distrusted (#585) stays trusted for every install below.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    libssl-dev \
    libffi-dev \
    build-essential \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/ /app/requirements/

# Create a virtual environment that inherits system-site-packages (to use torch/torchaudio)
RUN python -m venv --system-site-packages /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Capture the system torch/torchaudio versions as pip constraints.
RUN python -c "import torch; print(f'torch=={torch.__version__}')" > constraints.txt && \
    python -c "import torchaudio; print(f'torchaudio=={torchaudio.__version__}')" >> constraints.txt || true

# Install dependencies using the constraints to force usage of system torch
RUN pip install --no-cache-dir -r requirements/worker.txt -c constraints.txt

# fastembed caps pillow below the release that fixes its advisories, so it goes
# in without its declared dependencies; worker.txt pins the ones it needs.
# requirements/worker-no-deps.txt explains.
RUN pip install --no-cache-dir --no-deps -r requirements/worker-no-deps.txt

# Install pyannote.audio without dependencies to use system torch. The pin is
# read from local.txt so the image and a GPU host install cannot drift apart.
RUN pip install --no-cache-dir --no-deps \
        "$(grep -E '^pyannote\.audio==' requirements/local.txt)" -c constraints.txt

# torchcodec on PyPI is built against the CUDA that PyPI torch ships, not the
# CUDA of this base image, and a mismatch stops it loading (libcudart not found),
# which leaves pyannote with no audio decoder. Swap in the CPU build of the
# version worker.txt resolved: torchcodec only decodes audio here, which never
# touches the GPU, and the CPU build links no CUDA library at all.
RUN torchcodec_version="$(python -c 'import importlib.metadata as m; print(m.version("torchcodec").split("+")[0])')" && \
    pip install --no-cache-dir --no-deps --force-reinstall \
        --index-url https://download.pytorch.org/whl/cpu "torchcodec==${torchcodec_version}+cpu"

# Parakeet ASR (onnx-asr) requires the CUDA build of ONNX Runtime. worker.txt
# pins the CPU-only onnxruntime; replace it with onnxruntime-gpu. Its PyPI
# builds target CUDA 13 from 1.27.0 and CUDA 12 before that, so this pin must
# move with the CUDA major of the base image above.
RUN pip uninstall -y onnxruntime onnxruntime-gpu && \
    pip install --no-cache-dir onnxruntime-gpu==1.31.0

# Install Triton in the venv so Whisper word-level timestamps use GPU-accelerated
# kernels instead of falling back to slower CPU implementations. The base PyTorch
# image ships Triton as a system package, but the venv may not inherit it correctly.
RUN pip install --no-cache-dir triton

# --- Runtime Stage ---
FROM pytorch/pytorch:2.14.1-cuda13.0-cudnn9-runtime@sha256:3c0b174a1339193a5bcc4b37d737c9f5ca3c4782a2293d3888e4271367eddf44 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:$PATH"
ENV MALLOC_ARENA_MAX=2
# ONNX Runtime 1.29+ on Linux uploads usage telemetry to Microsoft by default.
# This stops it for every process in the image, including ones that never import
# backend (which sets the same default).
ENV ORT_DISABLE_TELEMETRY=1
# huggingface_hub 1.32+ keeps Xet downloads in a cache-wide store sharded by
# hash, so an fp32 ONNX graph and its external weights land in different
# directories and ONNX Runtime 1.31 refuses to load them (#448). backend sets
# the same default.
ENV HF_HUB_DISABLE_SHARED_BLOBS=1
ENV LD_PRELOAD=/usr/lib/x86_64-linux-gnu/libjemalloc.so.2

RUN apt-get update && \
    # Patch everything the pinned PyTorch base ships behind the Ubuntu archive,
    # as Dockerfile.api does. The base is not republished for Ubuntu fixes, and
    # the scan has flagged OpenSSL (CVE-2026-45447, CVE-2026-84782) and the
    # linux-libc-dev kernel headers, which it reports although a container runs
    # the host's kernel. An upgrade of named packages missed ca-certificates,
    # which left the distrusted emSign ECC Root CA - G3 in the OS bundle that
    # the LLM SDKs verify against (#585). The upgrade takes the archive's newest
    # builds whenever this layer is rebuilt.
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libjemalloc2 \
    gosu \
    # Local OCR for document parsing: the middle tier between a vision model
    # and a format's own text layer, so a scanned page is readable with no AI
    # provider configured. The system binary rather than an ONNX OCR package on
    # purpose -- those depend on onnxruntime, which the pip step above
    # deliberately replaces with onnxruntime-gpu, and reintroducing the CPU
    # build alongside it is the exact conflict that replacement prevents.
    # -eng only; other language packs are ~4 MB each and unused.
    tesseract-ocr \
    tesseract-ocr-eng \
    && \
    rm -rf /var/lib/apt/lists/*

# The PyTorch base ships a system Python with vulnerable pillow/urllib3 in
# /usr/local/lib/.../dist-packages. The venv (system-site-packages) shadows them
# at import time with the patched versions from requirements, but the old files
# remain on disk and are flagged by the image scan. Upgrade the system copies in
# place (as root, before the USER switch) to the same patched versions. Keep these
# pins in step with requirements/base.txt and requirements/worker.txt:
# pillow==13.0.0 closes the 20 advisories fixed only in that release (#526);
# urllib3==2.8.0 closes CVE-2026-44431/44432 and CVE-2026-97687/97689;
# fsspec==2026.9.0 keeps the CVE-2026-104851 fix;
# filelock==4.2.1 (torch and huggingface_hub use this copy, as the venv has none)
# closes CVE-2026-112940; dnspython==2.9.0 (only python-etcd from the base
# image needs it) closes CVE-2026-114605.
#
# certifi is the exception: no requirements file pins it, and the venv has no
# copy of its own, so this system copy is the CA bundle the worker verifies TLS
# with. It takes the newest release at build time, as the api image's venv
# does; the floor keeps the GHSA-6q48-6c7w-9gw2 fix (#531).
#
# Then uninstall uv and remove that system pip. The worker runs Celery and never
# invokes uv: uninstalling it with pip removes the uv and uvx binaries, whose
# bundled rustls-webpki (GHSA-82j2-j2ch-gfr8) the scan flags, together with the
# package metadata the scan reports for GHSA-hq85-5cpj-mr62 (#531). The worker
# never runs the system pip either (the venv has its own), and from 26.2 it ships
# an SBOM of its vendored urllib3, msgpack and setuptools, whose fixable HIGH
# CVEs the image scan reports like installed packages.
RUN /usr/bin/python3 -m pip install --no-cache-dir --break-system-packages \
    --root-user-action=ignore --upgrade pillow==13.0.0 urllib3==2.8.0 fsspec==2026.9.0 \
    filelock==4.2.1 dnspython==2.9.0 \
    "certifi>=2026.10.19" && \
    /usr/bin/python3 -m pip uninstall -y --break-system-packages \
    --root-user-action=ignore uv pip && \
    ! test -e /usr/local/bin/uv && ! test -e /usr/local/bin/uvx

# Put the CUDA wheel libraries on the dynamic loader path. Despite the `cudnn9` tag,
# this base ships CUDA and cuDNN only as nvidia-* wheels under dist-packages,
# with nothing in a system lib dir or the ldconfig cache. torch copes, because it
# ctypes-preloads its own wheel libraries with RTLD_GLOBAL, but onnxruntime-gpu does
# not: libonnxruntime_providers_cuda.so is linked against cuDNN 9's split
# sub-libraries (libcudnn_adv, _ops, _cnn, _graph, _heuristic, _engines_*), which
# torch never preloads, plus libcublasLt. Without this the loader cannot resolve
# them, the CUDA execution provider is silently dropped, and Canary/Parakeet ASR and
# text embeddings run on CPU while torch still reports CUDA as available.
#
# Register every wheel lib directory rather than just cuDNN's, so the CUDA provider
# loads on its own merits instead of depending on torch being imported first. These
# are CUDA runtime libraries only; the driver libraries still come from
# /usr/local/nvidia/lib*, which LD_LIBRARY_PATH resolves ahead of the ldconfig cache.
# Read paths from __path__ rather than __file__: the nvidia-* wheels are PEP 420
# namespace packages, whose __file__ is None. The greps assert the layout so a future
# base bump fails the build here instead of degrading to CPU in production.
RUN /usr/bin/python3 -c \
      "import nvidia, os, glob; \
       print('\n'.join(sorted(d for p in nvidia.__path__ \
             for d in glob.glob(os.path.join(p, '*', 'lib')))))" \
      > /etc/ld.so.conf.d/nvidia-cuda-wheels.conf && \
    ldconfig && \
    ldconfig -p | grep -q libcudnn_adv.so.9 && \
    ldconfig -p | grep -q libcublasLt.so.13

COPY --from=builder /opt/venv /opt/venv

# Fail the build, not the first diarisation, if torchcodec cannot load against
# this image's torch, CUDA runtime and FFmpeg.
RUN python -c "from torchcodec.decoders import AudioDecoder"

# Likewise for fastembed, installed without its declared dependencies: its
# import loads every one of them, so a dependency worker.txt stopped pinning
# fails the build here.
RUN python -c "from fastembed import TextEmbedding"

# Validate the native Nemotron classes/frontend without fetching weights or
# executing a model. Keep this in the final image, after all dependency swaps.
RUN HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 python -c \
    "from transformers import Nemotron3DiarizationConfig, Nemotron3DiarizationForAudioFrameClassification, Nemotron3DiarizationProcessor, NemotronAsrStreamingFeatureExtractor; \
     processor = Nemotron3DiarizationProcessor(NemotronAsrStreamingFeatureExtractor()); \
     model = Nemotron3DiarizationForAudioFrameClassification(Nemotron3DiarizationConfig())"

WORKDIR /app

COPY . .

# worker-io inherits these prompt files and the same validation from this image.
RUN python -c "from backend.prompts import load_registry; load_registry()"

# Create the non-root appuser that the entrypoint drops to at runtime.
# The Ubuntu 24.04-based PyTorch image ships a default user at UID 1000; remove
# whatever occupies 1000 first so appuser keeps UID 1000 for mounted-volume
# ownership. Create directories for volumes to ensure they are owned by appuser.
RUN if getent passwd 1000 >/dev/null 2>&1; then \
        userdel -r "$(getent passwd 1000 | cut -d: -f1)" 2>/dev/null || true; \
    fi && \
    useradd -m -u 1000 appuser && \
    mkdir -p /home/appuser/.cache/huggingface && \
    mkdir -p /app/data && \
    chown -R appuser:appuser /app /home/appuser

RUN chmod +x backend/worker_entrypoint.sh

# The image intentionally does NOT `USER appuser`: the entrypoint enters as root
# only to repair ./data bind-mount ownership, then drops to appuser via gosu, so
# the worker process runs as uid 1000 (asserted at runtime by the release smoke).
ENTRYPOINT ["backend/worker_entrypoint.sh"]

# Default command: a single worker draining all resource lanes (gpu, cpu, io)
# with embedded Celery Beat (-B), so a standalone `docker run` of this image
# still processes everything and fires periodic jobs (15-minute calendar sync,
# 24-hour temp cleanup, calendar push-channel renewal). The beat schedule DB
# lives on the persistent ./data volume so the cadence survives restarts.
#
# In the Compose deployment this CMD is overridden: work is split across the
# worker-gpu / worker-cpu / worker-io services, and beat (-B) runs on the io
# worker ONLY, so periodic jobs cannot double-schedule.
CMD ["celery", "-A", "backend.celery_app.celery_app", "worker", "-B", "-s", "/app/data/celerybeat-schedule", "-Q", "gpu,cpu,io", "--pool=solo", "--concurrency=1", "--loglevel=info"]
