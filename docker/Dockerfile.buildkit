# The BuildKit daemon that builds the release images on the release host.
#
# Nothing builds this file. scripts/release.py reads the image reference from
# the FROM line and runs its docker-container builder on it, so the pin lives
# where Dependabot's docker ecosystem keeps it current alongside the bases.
FROM moby/buildkit:v0.33.1@sha256:cec9f139f45e93c5c69c60f8b07cfad9f43f4ef6b6a6cd917527fea5ff2e3dea
