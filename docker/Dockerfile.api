# --- Builder Stage ---
# Pinned by digest for reproducible builds; Dependabot keeps the tag comment current.
#
# The Python minor MUST stay 3.12, matching the worker image, CI, and the mypy
# target. The worker's interpreter is not freely choosable: it comes from the
# PyTorch base image, which ships 3.12. Running the API on a different minor
# means the interpreter serving every HTTP request is the one the test suite
# never runs on. Both stages below must move together, or the venv is built on a
# different interpreter than it executes on. scripts/check_held_pins.py enforces
# this, and .github/dependabot.yml holds the base image at 3.12.
FROM python:3.12-slim@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2 AS builder

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive

# The upgrade matters here although this stage ships only /opt/venv: pip
# verifies PyPI against the OS trust store as well as its own, so a CA that
# Debian has distrusted (#585) stays trusted for the install below until the
# base image is republished.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    git \
    libssl-dev \
    libffi-dev \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements/ /app/requirements/

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
# Swap the venv's pip, a copy of the base image's, for the hash-pinned release
# in requirements/pip.txt before it downloads anything, then remove it: the
# runtime never runs pip, and from 26.2 pip ships an SBOM of its vendored
# urllib3, msgpack and setuptools, whose fixable CVEs the image scan reports
# like installed packages.
RUN pip install --no-cache-dir --require-hashes -r requirements/pip.txt && \
    pip install --no-cache-dir -r requirements/backend.txt && \
    python -m pip uninstall -y pip && \
    ! test -e /opt/venv/bin/pip

# --- Runtime Stage ---
# Must be the same image as the builder stage above; see the note there.
FROM python:3.12-slim@sha256:cb33f7f771ecec2ef1225cf39b159591a040391bd73e4c01f00fdfc4c47611d2 AS runtime

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/opt/venv/bin:$PATH"

# ffmpeg is needed for audio duration checks and basic processing
# libsndfile1 is needed for audio processing
# gosu drops the entrypoint from root to appuser after the ./data bind-mount
# ownership repair. Sourced from the distro (Trivy OS-scanner coverage + distro
# security auto-patch) rather than a hand-copied binary.
#
# `apt-get upgrade` patches the packages the base image ships, which
# `apt-get install` alone never touches. The base is pinned by digest and
# upstream republishes it every few weeks, so Debian security fixes reach the
# archive well before they reach any digest this file could pin. Ahead of 2.5.1
# the newest python:3.12-slim (built 2026-09-01) still carried fixable
# CRITICAL/HIGH findings in gzip, libpcre2, libsqlite3 and perl-base, and the
# release scan gate fails on those. The builder stage upgrades too, for the
# trust store its pip downloads through.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Remove the base image's own pip, as the builder removed the venv's copy.
# Nothing at runtime runs it, and its vendored certifi (2024.08.30 in the base
# pinned above) still trusts the distrusted emSign ECC Root CA - G3 (#585).
RUN /usr/local/bin/python3 -m pip uninstall -y --root-user-action=ignore pip && \
    ! test -e /usr/local/bin/pip

COPY --from=builder /opt/venv /opt/venv

WORKDIR /app

ARG NOJOIN_SERVER_VERSION
ENV NOJOIN_SERVER_VERSION=${NOJOIN_SERVER_VERSION}

COPY . .

# Fail the image build if a shipped prompt file or its contract is incomplete.
RUN python -c "from backend.prompts import load_registry; load_registry()"

RUN set -eu; \
    version="${NOJOIN_SERVER_VERSION:-}"; \
    if [ -z "$version" ] && [ -f /app/docs/VERSION ]; then \
        version="$(tr -d '[:space:]' < /app/docs/VERSION)"; \
    fi; \
    version="${version#v}"; \
    if [ -z "$version" ]; then \
        version="0.0.0"; \
    fi; \
    printf '%s\n' "$version" > /app/.build-version

RUN chmod +x /app/backend/entrypoint.sh

# Create the non-root appuser and the mounted-volume directories it must own.
# The image intentionally does NOT `USER appuser`: the entrypoint enters as root
# only to repair ./data bind-mount ownership, then drops to appuser via gosu, so
# the long-running process runs as uid 1000 (asserted by the release smoke test).
RUN useradd -m -u 1000 appuser && \
    mkdir -p /shared_model_cache && \
    chown -R appuser:appuser /app /shared_model_cache

EXPOSE 8000

ENTRYPOINT ["/app/backend/entrypoint.sh"]

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
