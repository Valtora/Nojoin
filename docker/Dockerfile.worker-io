# --- io-specific worker image ---
# The base worker image (docker/Dockerfile.worker) plus Node.js, the Claude Code
# CLI + Agent SDK, and the OpenAI Codex CLI — used ONLY by the worker-io lane for
# the CLI OAuth AI mode (routing inference through a user's own Claude or ChatGPT
# subscription). Keeping the Node/CLI tooling here (rather than in the shared
# worker image) leaves worker-gpu / worker-cpu unchanged — no Node tooling (nor
# the ~336 MB Codex payload) rides along on the GPU-constrained host that never
# uses it.

# WORKER_BASE_IMAGE lets this layer stack on either the locally-built worker
# image (nojoin-worker:local) or the published tag in the release pipeline.
# Declared before any FROM (global scope) so the final-stage FROM can use it.
ARG WORKER_BASE_IMAGE=ghcr.io/valtora/nojoin-worker:latest

# Node.js runtime, PINNED BY DIGEST (supply-chain hardening — replaces the
# unpinned NodeSource curl|bash install). Bump this digest to move Node
# deliberately; .github/dependabot.yml holds Node majors back for hand review.
# The Anthropic CLI + Agent SDK are LLM SDKs and stay UNPINNED per the repo
# policy (allow latest); only the Node runtime shipping them is pinned.
#
# The `-bookworm-slim` variant is load-bearing and NOT interchangeable with the
# `-alpine` one that frontend/Dockerfile uses. This stage is only a donor: the
# bare `node` binary is copied into the PyTorch base below, which is Ubuntu 24.04
# (glibc 2.39). Debian bookworm builds against glibc 2.36, and glibc is forward
# compatible, so that binary runs there. An Alpine build links against musl and
# would find no loader in the Ubuntu base at all. The frontend image has the
# opposite requirement — it runs Node standalone, so it takes the smaller Alpine
# base. The two therefore stay different on purpose.
FROM node:26-bookworm-slim@sha256:2d49d876e96237d76de412761cf05dbfe5aee325cc4406a4d41d5824c5bb8beb AS node

FROM ${WORKER_BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
USER root

# Bring in the pinned Node runtime + npm (dynamically linked against libc /
# libstdc++ already present in the PyTorch base). npm installs two subscription
# CLIs, then is removed: the Claude Code CLI (JS, runs directly on node) and the
# OpenAI Codex CLI (@openai/codex, a self-contained native binary). npm's bundled
# deps (picomatch, sigstore) would otherwise ride along at runtime and trip the
# Trivy HIGH gate. Both are LLM tooling and stay UNPINNED per the repo policy
# (allow latest). The Codex payload is a large (~285 MB) stripped static binary
# that Trivy cannot introspect (ADR-0002): it adds no scannable CVEs but is an
# unaudited vendor artifact — an accepted trade-off recorded in the ADR. claude is
# symlinked to /usr/bin/claude (historical path); codex lands at
# /usr/local/bin/codex (npm's global bin, where NOJOIN_CODEX_PATH defaults).
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && npm install -g @anthropic-ai/claude-code @openai/codex \
    && ln -sf "$(readlink -f "$(command -v claude)")" /usr/bin/claude \
    && pip install --no-cache-dir claude-agent-sdk \
    && rm -rf /usr/local/lib/node_modules/npm /usr/lib/node_modules/npm \
        /usr/local/bin/npm /usr/local/bin/npx /root/.npm

# Default to root, matching the base worker image: the inherited worker entrypoint
# enters as root to repair ./data ownership, then drops to appuser via gosu at
# runtime. (Was `USER appuser`, before the base image moved to a gosu drop.)
USER root
